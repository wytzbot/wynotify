{
  "rewrites":[
    {"source":"/api/:path*","destination":"/api/index.js"},
    {"source":"/(.*)","destination":"/"}
  ],
  "headers":[
    {"source":"/firebase-messaging-sw.js","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}
